{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/../../team/bin/boot.py\" theo"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/../../team/bin/guard.py\" theo"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/../../team/bin/send_ok.py\" arm"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "mcp__*__delete_*",
      "mcp__*__trash_*",
      "mcp__*__batch_delete_*",
      "mcp__*__create_payment",
      "mcp__*__initiate_payment",
      "mcp__*__make_payment",
      "mcp__*__add_reaction",
      "mcp__*__slack_add_reaction",
      "mcp__*__addReaction",
      "mcp__*__remove_reaction",
      "mcp__*__removeReaction",
      "mcp__*__react"
    ]
  }
}
